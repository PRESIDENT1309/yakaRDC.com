{
  "expo": {
    "name": "YakaRDC",
    "slug": "yaka-rdc",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yaka",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAEEDA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.yaka.app"
    },
    "android": {
      "package": "cd.yaka.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAEEDA"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icon-512.png"
    }
  }
}